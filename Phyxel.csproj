<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RollForward>Major</RollForward>
    <UseWindowsForms>true</UseWindowsForms>
    <OutputType>WinExe</OutputType>
    <RootNamespace>Phyxel</RootNamespace>
    <AssemblyName>Phyxel</AssemblyName>
    <ApplicationIcon>Icon.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <DefineConstants>$(DefineConstants);WINDOWSDX</DefineConstants>
    <KniPlatform>Windows</KniPlatform>
    <GraphicsProfile>HiDef</GraphicsProfile>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="nkast.Xna.Framework" Version="4.2.9001" />
    <PackageReference Include="nkast.Xna.Framework.Content" Version="4.2.9001" />
    <PackageReference Include="nkast.Xna.Framework.Graphics" Version="4.2.9001" />
    <PackageReference Include="nkast.Xna.Framework.Audio" Version="4.2.9001" />
    <PackageReference Include="nkast.Xna.Framework.Media" Version="4.2.9001" />
    <PackageReference Include="nkast.Xna.Framework.Input" Version="4.2.9001" />
    <PackageReference Include="nkast.Xna.Framework.Game" Version="4.2.9001" />
    <PackageReference Include="nkast.Xna.Framework.Devices" Version="4.2.9001" />
    <PackageReference Include="nkast.Xna.Framework.Storage" Version="4.2.9001" />
    <PackageReference Include="nkast.Xna.Framework.XR" Version="4.2.9001" />
    <PackageReference Include="nkast.Kni.Platform.WinForms.DX11" Version="4.2.9001" />
    <PackageReference Include="nkast.Xna.Framework.Content.Pipeline.Builder" Version="4.2.9001" />
    <PackageReference Include="SharpDX.D3DCompiler" Version="4.2.0" />
  </ItemGroup>
  <ItemGroup>
    <KniContentReference Include="Content\PhyxelContent.mgcb" />
    <None Update="Content\Shaders\**\*.*" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Content\UI\MaterialCards\*.png" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Content\UI\FilterCards\*.png" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Content\UI\Icons\**\*.*" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Materials\**\*.json" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Diagnostics\Profile-GPU.ps1" Link="Profile-GPU.ps1" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Update="Diagnostics\Profile-GPU.cmd" Link="Profile-GPU.cmd" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Update="Diagnostics\Profile-Scene.ps1" Link="Profile-Scene.ps1" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Update="Diagnostics\Profile-Scene.cmd" Link="Profile-Scene.cmd" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Update="Diagnostics\Profile-Coal.ps1" Link="Profile-Coal.ps1" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Update="Diagnostics\Profile-Coal.cmd" Link="Profile-Coal.cmd" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Update="Diagnostics\RunFirePerformance.ps1" Link="Diagnostics\RunFirePerformance.ps1" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <PropertyGroup>
    <ShaderDotNetHost Condition="'$(DotNetHostPath)' != ''">$(DotNetHostPath)</ShaderDotNetHost>
    <ShaderDotNetHost Condition="'$(ShaderDotNetHost)' == ''">dotnet</ShaderDotNetHost>
  </PropertyGroup>
  <!-- Runtime compilation is a fallback, not a first-launch requirement.
       Use this exact assembly/compiler/flags to generate portable DXBC. -->
  <Target Name="PrepareComputeShaders" AfterTargets="Build"
          Condition="'$(DesignTimeBuild)' != 'true' and '$(SkipShaderPackaging)' != 'true'">
    <Exec Command="&quot;$(ShaderDotNetHost)&quot; &quot;$(TargetPath)&quot; --prepare-shaders &quot;$(MSBuildProjectDirectory)/Graphics/GpuResourceLifecycleManager.cs&quot; &quot;$(TargetDir)Content/CompiledShaders&quot;" />
  </Target>
  <Target Name="PublishComputeShaders" AfterTargets="ComputeFilesToPublish" DependsOnTargets="PrepareComputeShaders"
          Condition="'$(SkipShaderPackaging)' != 'true'">
    <ItemGroup>
      <_CompiledShaderFile Include="$(TargetDir)Content/CompiledShaders/*.cso*" />
      <ResolvedFileToPublish Include="@(_CompiledShaderFile)">
        <RelativePath>Content/CompiledShaders/%(_CompiledShaderFile.Filename)%(_CompiledShaderFile.Extension)</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>
</Project>
